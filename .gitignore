# =============================================================================
# Fine-Tuning Small AI Models: LoRA, QLoRA & Evaluation
# =============================================================================
# Students clone this repo into a Codespace. Anything a student does not need,
# or anything that is regenerated by running the labs, stays out of git.
# =============================================================================

# -----------------------------------------------------------------------------
# Instructor materials (kept alongside the repo, not tracked in it)
# -----------------------------------------------------------------------------
# The slide deck lives with the course but is delivered to attendees separately.
# Decks are large binaries that diff badly and bloat clone times forever.
*.pptx
*.potx
*.ppt
*.pps
*.ppsx
*.key
~$*.pptx
~$*.docx
~$*.xlsx

# -----------------------------------------------------------------------------
# Lab output — every one of these is regenerated by running the labs
# -----------------------------------------------------------------------------
out/
outputs/
runs/
checkpoint-*/
wandb/
lightning_logs/
results*.json

# -----------------------------------------------------------------------------
# Model weights and adapters
# -----------------------------------------------------------------------------
# Nothing in this repo ships weights; they are all pulled from the Hugging Face
# Hub by scripts/prefetch_models.sh. If one of these appears, it is lab output.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
*.ggml
*.msgpack
*.h5
adapter_model.*
pytorch_model*

# -----------------------------------------------------------------------------
# Hugging Face / model caches
# -----------------------------------------------------------------------------
.cache/
hf_cache/
.huggingface/
transformers_cache/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
py_env/
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Secrets and local config
# -----------------------------------------------------------------------------
# No lab needs a token, but attendees experimenting on their own might add one.
.env
.env.*
!.env.example
*.pem
secrets.*
.hf_token
.netrc

# -----------------------------------------------------------------------------
# Archives and scratch
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
tmp/
scratch/
*.log
*.bak
*.orig
*.rej

# -----------------------------------------------------------------------------
# Editors and OS
# -----------------------------------------------------------------------------
# NOTE: .devcontainer/ is intentionally NOT ignored -- it is how the Codespace
# is built. Only personal editor state is excluded.
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Node (only if someone adds tooling later)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
