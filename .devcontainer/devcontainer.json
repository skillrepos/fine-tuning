{
    "name": "Fine-Tuning Small AI Models (LoRA, QLoRA & Evaluation)",
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",
    "remoteEnv": {
        "HF_HOME": "${containerWorkspaceFolder}/.cache/huggingface",
        "TOKENIZERS_PARALLELISM": "false",
        "OMP_NUM_THREADS": "4"
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.11"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.terminal.activateEnvInCurrentTerminal": true,
                "python.defaultInterpreterPath": ".venv/bin/python",
                "github.copilot.enable": { "*": false },
                "github.copilot.enableAutoComplete": false,
                "editor.inlineSuggest.enabled": false,
                "workbench.startupEditor": "readme",
                "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor" },
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": { "path": "bash", "args": ["-l"] }
                }
            },
            "extensions": [
                "ms-python.python",
                "mathematic.vscode-pdf",
                "vstirbu.vscode-mermaid-preview"
            ]
        }
    },
    "postCreateCommand": "bash -i scripts/pysetup.sh .venv && bash -i scripts/prefetch_models.sh"
}
