{
    "name": "Fine-Tuning Small AI Models (LoRA, QLoRA & Evaluation)",
    "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
    "remoteEnv": {
        "HF_HOME": "${containerWorkspaceFolder}/.cache/huggingface",
        "TOKENIZERS_PARALLELISM": "false",
        // A "4-core" Codespace is 2 physical cores x SMT. Measured on an
        // EPYC 9V74: 4 threads is ~17% SLOWER than 2 for this workload.
        "OMP_NUM_THREADS": "2"
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.terminal.activateEnvInCurrentTerminal": true,
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
                "github.copilot.enable": { "*": false },
                "github.copilot.enableAutoComplete": false,
                "editor.inlineSuggest.enabled": false,
                "workbench.startupEditor": "readme",
                "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor" },
                "terminal.integrated.defaultProfile.linux": "bash",
                // Yellow highlights in the lab starter files marking where merged
                // code goes. Set to false to keep only the diff-view hover notes.
                "mergeInfo.skeletonHighlights": true,
                "terminal.integrated.profiles.linux": {
                    "bash": { "path": "bash", "args": ["-l"] }
                }
            },
            "extensions": [
                "ms-python.python",
                "vstirbu.vscode-mermaid-preview"
            ]
        }
    },
    "postCreateCommand": "bash -i scripts/pysetup.sh .venv && bash -i scripts/prefetch_models.sh",
    // Install the Merge Info extension, which shows the hover notes in the
    // code -d diff views and the yellow highlights in the starter files (notes live in merge-info.json at the repo root).
    // Retries because the install silently fails if VS Code is not ready yet.
    "postAttachCommand": {
        "merge-info": "nohup bash -c 'for i in 1 2 3 4 5 6; do code --install-extension ${containerWorkspaceFolder}/.devcontainer/merge-info-0.2.0.vsix --force && break; sleep 10; done' >/tmp/merge-info-install.log 2>&1 &"
    }
}
